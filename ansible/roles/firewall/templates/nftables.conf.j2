#!/usr/sbin/nft -f
# MANAGED BY ANSIBLE -- roles/firewall. Hand edits are lost on the next run.

# Replace ONLY our own table. `flush ruleset` here is what took staging down on
# 2026-08-17 (see .claude/memory/incidents.md): it deletes every table on the host,
# including the ones k3s and the CNI own.
#
# kube-proxy survives that -- it reconciles its KUBE-* chains within seconds and you never
# notice. The CNI portmap plugin does NOT: it writes ingress-nginx's hostPort 80/443 DNAT
# rules once, when the pod sandbox is created, and never checks them again. Flushing them
# leaves a healthy-looking cluster that the internet cannot reach.
#
# Declaring the table before deleting it makes this idempotent on a host where it does not
# exist yet -- `delete table` alone fails on a first run.
table inet filter
delete table inet filter

{% set cni = firewall_cni_interfaces | map('regex_replace', '^(.*)$', '"\\1"') | join(', ') %}
table inet filter {
  chain input {
    type filter hook input priority 0; policy drop;

    iif lo accept comment "loopback is not a threat model"
    ct state established,related accept
    ct state invalid drop

    # Ping stays reachable: losing ICMP costs you your simplest liveness check, and
    # rate limiting removes the only reason people block it.
    ip protocol icmp icmp type echo-request limit rate 4/second accept
    ip6 nexthdr ipv6-icmp accept

    tcp dport { {{ firewall_ssh_port }} } accept comment "ssh"
    tcp dport { {{ firewall_public_tcp_ports | join(', ') }} } accept comment "ingress-nginx hostPort"

    # Cluster-internal traffic. 6443 (kube-apiserver) and 9100 (node-exporter) are
    # deliberately absent from the public accepts: the API is reached over an SSH tunnel,
    # and node-exporter is scraped by Prometheus pods, whose packets arrive HERE -- on a
    # CNI interface -- not on the public one. That is the whole reason 9100 can be bound
    # to the node's address and still be unreachable from the internet.
    iifname { {{ cni }} } accept comment "k3s CNI"
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    # Pod networking IS forwarded traffic. Without these three rules cluster DNS fails
    # and every symptom points somewhere else.
    ct state established,related accept
    iifname { {{ cni }} } accept
    oifname { {{ cni }} } accept
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}
