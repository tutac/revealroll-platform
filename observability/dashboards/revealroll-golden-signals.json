{
  "title": "RevealRoll — Golden Signals",
  "uid": "revealroll-golden",
  "tags": ["revealroll", "staging"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "What a user sees",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability (blackbox probe)",
      "description": "1 = the public URL answered. This is the outermost signal: DNS, firewall, ingress, TLS and the app, end to end.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(probe_success{job=\"blackbox-http\"}[1h])",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Probe duration",
      "description": "How long the public URL takes to answer, measured from inside the cluster.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"blackbox-http\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "TLS certificate — days to expiry",
      "description": "cert-manager renews at 30 days. Trending down past 21 means renewal is failing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 21 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "RED — measured at the ingress",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Request rate by status class",
      "description": "Traffic. Every request to stg.revealroll.com passes through ingress-nginx, so this works without instrumenting the app.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(nginx_ingress_controller_requests{exported_namespace=\"revealroll\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Error rate (5xx as % of all requests)",
      "description": "Errors. The ratio matters, not the count — 10 errors in 10 requests and 10 in 100000 are different incidents.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(nginx_ingress_controller_requests{exported_namespace=\"revealroll\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(nginx_ingress_controller_requests{exported_namespace=\"revealroll\"}[5m])), 0.001)",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "Duration. From a histogram — the buckets are the source of truth, an average would hide the tail that users actually feel.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=\"revealroll\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=\"revealroll\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=\"revealroll\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Saturation — the pods",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Memory working set vs limit",
      "description": "Approaching the limit means an OOM kill, not a slowdown. Memory is not compressible.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"revealroll\",container=\"revealroll\"})",
          "legendFormat": "{{pod}}"
        },
        {
          "refId": "B",
          "expr": "min(kube_pod_container_resource_limits{namespace=\"revealroll\",container=\"revealroll\",resource=\"memory\"})",
          "legendFormat": "limit"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "No CPU limit is set on purpose (see values.yaml), so this can exceed the request without being throttled.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"revealroll\",container=\"revealroll\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Available replicas",
      "description": "Should be 2. Dropping to 1 is survivable and invisible to users — which is exactly why it needs a graph.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"revealroll\",deployment=\"revealroll\"}",
          "legendFormat": "available"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_spec_replicas{namespace=\"revealroll\",deployment=\"revealroll\"}",
          "legendFormat": "desired"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Container restarts (1h)",
      "description": "A restart the site survived is still a defect. Flat is the only acceptable shape.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"revealroll\"}[1h]))",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
